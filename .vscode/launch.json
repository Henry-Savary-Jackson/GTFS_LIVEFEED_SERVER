{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python Debugger: Current File with Arguments",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "args": [
                "${command:pickArgs}"
            ]
        },
        {
            "name": "Python: Webapp",
            "type": "debugpy",
            "request": "launch",
            "program": ".venv/bin/gunicorn",
            "gevent": true,
            "console": "integratedTerminal",
            "envFile": "${workspaceFolder}/.env",
            "args": [
                "app:app",
                "--bind=127.0.0.1:5000",
                "--reload",
                "--worker-class",
                "gevent",
                "--log-level","debug",
                "--log-file","server_files/shared_private/server.log",
                "--timeout=7200"
            ],
        }
        ,{
            "name": "Celery",
            "type": "debugpy",
            "request": "launch",
            "module": "celery",
            "console": "integratedTerminal",
            "env": {"GEVENT_SUPPORT":"True"},
            "envFile": "${workspaceFolder}/.env",
            "args": [
                "--app",
                "app.celery_app",
                "worker",
                "--loglevel",
                "INFO",
                "--logfile","server_files/shared_private/celery.log", 
                "--pool",
                "gevent",
                "-E"
            ]
        },]
    
        , "compounds": [
            {
                "name": "Server with celery",
                "configurations": [ "Celery", "Python: Webapp"]
            }
        ]
}